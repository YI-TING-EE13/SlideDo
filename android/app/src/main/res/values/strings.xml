    <string name="tutorial_first_instruction">Highlighted tiles share a row or column with the empty cell. Tap the emphasized 6 to make your first move.</string>
    <string name="tutorial_line_instruction">Now tap the emphasized 5. It is farther away, so the model slides the whole row in one move.</string>
    <string name="tutorial_complete_instruction">The row moved together and still counted as one move. Start a 3x3 puzzle when you are ready.</string>
