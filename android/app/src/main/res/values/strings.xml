    <string name="onboarding_goal_title">Build the Ordered Board</string>
    <string name="onboarding_goal_body">Arrange 1, 2, 3... row by row. The empty cell belongs in the bottom-right corner.</string>
    <string name="onboarding_tap_title">Tap or Swipe Movable Tiles</string>
    <string name="onboarding_tap_body">Tap a tile in the same row or column as the empty cell. You can also swipe a movable tile toward the empty space.</string>
    <string name="onboarding_line_title">Slide a Whole Line</string>
    <string name="onboarding_line_body">Farther aligned tiles pull every tile between them and the empty cell. The whole slide counts as one move and one undo step.</string>
    <string name="onboarding_tools_title">Use Tools Without Losing Records</string>
    <string name="onboarding_tools_body">Undo backs up one gesture. Restart returns to the puzzle start. Records save only player solves, so solver-assisted wins stay separate.</string>
