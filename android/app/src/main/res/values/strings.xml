    <string name="how_title">How to Play</string>
    <string name="how_subtitle">Use the empty cell to pull tiles into order.</string>
    <string name="how_goal_title">Goal</string>
    <string name="how_goal_body">Arrange numbers row by row, with the empty cell in the bottom-right corner.</string>
    <string name="how_tap_title">Tap</string>
    <string name="how_tap_body">Tap any tile in the same row or column as the empty cell. Adjacent tiles move one step toward the empty space.</string>
    <string name="how_line_title">Whole-line slide</string>
    <string name="how_line_body">Tap a farther aligned tile to pull every tile between it and the empty cell. The full line slide still counts as one move.</string>
    <string name="how_swipe_title">Swipe</string>
    <string name="how_swipe_body">Swipe a movable tile toward the empty cell when you want a more tactile gesture.</string>
    <string name="how_tools_title">Tools</string>
    <string name="how_tools_body">Undo restores the previous gesture. Restart returns to the current puzzle\'s starting board. Save and Load live in the in-game menu.</string>
    <string name="how_records_title">Records</string>
    <string name="how_records_body">Best records compare fewer moves first, then lower time. Solver-assisted wins are shown, but they do not overwrite player records.</string>
    <string name="records_title">Records</string>
    <string name="records_subtitle">Your personal totals, bests, and recent completions stay on this device.</string>
    <string name="records_explanation">Player solves only. Fewer moves rank first; ties use faster time. Every completion appears in totals and recent history. Solver-assisted completions are labeled but never replace these records.</string>
